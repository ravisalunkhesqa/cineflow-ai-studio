# ==============================
# CineFlow AI Studio — Environment
# Copy this file to .env.local (root) and/or apps/api/.env
# NEVER commit the real .env / .env.local file.
# ==============================

# ---- AI Provider (XKiro) ----
# Set XTROUTER_API_KEY in the process environment; do not store the secret here.
XKIRO_BASE_URL=https://api.xkiro.com/v1

# ---- App ----
NODE_ENV=development
APP_NAME=CineFlow AI Studio
WEB_PORT=3000
API_PORT=4000
API_BASE_URL=http://localhost:4000

# ---- PostgreSQL ----
POSTGRES_USER=cineflow
POSTGRES_PASSWORD=cineflow_local_dev
POSTGRES_DB=cineflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cineflow:cineflow_local_dev@localhost:5432/cineflow?schema=public

# ---- Redis / BullMQ ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- MinIO (local object storage) ----
MINIO_ROOT_USER=cineflow_admin
MINIO_ROOT_PASSWORD=cineflow_local_dev_key
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET=cineflow-media

# ---- FFmpeg ----
# Leave blank to use ffmpeg/ffprobe found on PATH, or set an absolute path (Windows example below).
FFMPEG_PATH=
FFPROBE_PATH=
# Windows example:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# ---- Privacy ----
SEND_ONLY_REQUIRED_CONTEXT=true

# ---- Development only ----
# Enables MockProvider (IMAGE_OUTPUT/VIDEO_OUTPUT placeholder generation) so the
# generation job pipeline can be exercised before a real image/video provider is
# confirmed. NEVER set this to true in production. Requires NODE_ENV != production
# as well — both conditions must hold.
ENABLE_MOCK_PROVIDERS=false
