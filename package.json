{
  "name": "cineflow-ai-studio",
  "version": "0.1.0",
  "private": true,
  "description": "CineFlow AI Studio — local-first AI creative studio & filmmaking platform",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* run dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @cineflow/database run generate",
    "db:migrate": "pnpm --filter @cineflow/database run migrate"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
